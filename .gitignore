# not in the repo. Commit sanitized *.example.yaml templates instead.
*.secret.yaml
*secret*.yaml
cloudflared-token*
*.pem
*.key
kubeconfig
.env

# The old Cloudflare helm values held a live tunnel token — keep it untracked.
cloudflare-tunnel/kubernetes/values.yaml

