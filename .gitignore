# Secrets — never commit. Real secrets live in k8s Secrets (created via kubectl),
# not in the repo. Commit sanitized *.example.yaml templates instead.
*.secret.yaml
*secret*.yaml
cloudflared-token*
*.pem
*.key
*.conf
kubeconfig
.env
# OAuth client secrets / tokens (Gmail, etc.) — belong in ~/.config or a k8s Secret
client_secret*.json
*token*.json
credentials.json
# Generated by `homelab creds` — live values for every service, never commit
CREDENTIALS.md

# The old Cloudflare helm values held a live tunnel token — keep it untracked.
cloudflare-tunnel/kubernetes/values.yaml

# Local / generated / retired — keep on disk, never commit
.claude/
graphify-out/
k8-dashboard/
k8/
.codegraph/
# Agent-skill tooling installed locally (not project code)
.agents/
.codex/
skills-lock.json
