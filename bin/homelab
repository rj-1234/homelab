#!/usr/bin/env bash
# homelab — management CLI for the cheeky-mini k3s homelab.
# Zero deps beyond kubectl/tailscale/sudo. Host-first (run on the k3s node);
# the kubectl-only recipes also work from a remote admin machine with a valid
# KUBECONFIG. See `homelab help`.
set -euo pipefail

# ---- config (override via env) --------------------------------------------
: "${KUBECONFIG:=/etc/rancher/k3s/k3s.yaml}"
export KUBECONFIG
DOMAIN="${HOMELAB_DOMAIN:-ch33ky.org}"
TAILNET_HOST="${HOMELAB_TAILNET_HOST:-cheeky-mini.tail2f4253.ts.net}"
GRAFANA_TS_PORT="${HOMELAB_GRAFANA_TS_PORT:-8443}"
HEADLAMP_IP="${HOMELAB_HEADLAMP_IP:-10.43.142.241}"   # pinned ClusterIP
GRAFANA_IP="${HOMELAB_GRAFANA_IP:-10.43.200.10}"       # pinned ClusterIP
ADMIN_IP="${HOMELAB_ADMIN_IP:-10.43.13.38}"            # pinned ClusterIP (Flowers Admin)
TRAEFIK_IP="${HOMELAB_TRAEFIK_IP:-10.43.200.40}"       # pinned ClusterIP (dashboard/API, port 8080)
OPENWEBUI_IP="${HOMELAB_OPENWEBUI_IP:-10.43.200.52}"   # pinned ClusterIP (Open WebUI, port 8080)
ZOT_IP="${HOMELAB_ZOT_IP:-10.43.200.51}"               # pinned ClusterIP (self-hosted registry, port 5000)
HERMES_DASH_IP="${HOMELAB_HERMES_DASH_IP:-10.43.200.53}" # pinned ClusterIP (Hermes dashboard, port 9119)
HERMES_HINDSIGHT_UI_IP="${HOMELAB_HERMES_HINDSIGHT_UI_IP:-10.43.200.54}" # pinned ClusterIP (Hindsight control-plane UI, port 8890)
PROWLARR_IP="${HOMELAB_PROWLARR_IP:-10.43.200.20}"     # pinned ClusterIP (Prowlarr, port 9696)
RADARR_IP="${HOMELAB_RADARR_IP:-10.43.200.21}"         # pinned ClusterIP (Radarr, port 7878)
SONARR_IP="${HOMELAB_SONARR_IP:-10.43.200.22}"         # pinned ClusterIP (Sonarr, port 8989)
# repo root = parent of this script's dir
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# ---- helpers --------------------------------------------------------------
c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
info() { printf '%s==>%s %s\n' "$c_grn" "$c_off" "$*"; }
warn() { printf '%s!!%s %s\n'  "$c_ylw" "$c_off" "$*" >&2; }
die()  { printf '%sxx%s %s\n'  "$c_red" "$c_off" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }
k()    { kubectl "$@"; }

# service -> "namespace deployment"
svc_map() {
  case "$1" in
    jellyfin)   echo "media jellyfin" ;;
    homepage)   echo "platform homepage" ;;
    headlamp)   echo "platform headlamp" ;;
    cloudflared)echo "platform cloudflared" ;;
    grafana)    echo "monitoring monitoring-grafana" ;;
    prometheus) echo "monitoring prometheus-monitoring-kube-prometheus-prometheus" ;;
    admin)      echo "flowers admin-web" ;;
    pgweb)      echo "platform pgweb" ;;
    vllm)       echo "local-llm vllm" ;;
    open-webui) echo "local-llm open-webui" ;;
    zot)        echo "platform zot" ;;
    hermes)     echo "hermes hermes" ;;
    *) return 1 ;;
  esac
}
svc_ns()   { svc_map "$1" | awk '{print $1}'; }
svc_dep()  { svc_map "$1" | awk '{print $2}'; }

server_ip() { hostname -I | awk '{print $1}'; }

# ---- creds & secrets ------------------------------------------------------
cmd_token() {  # headlamp login bearer token
  need kubectl
  k -n platform create token headlamp --duration="${1:-168h}"
}
cmd_grafana_pw() {
  need kubectl
  k -n monitoring get secret grafana-admin -o jsonpath='{.data.admin-password}' | base64 -d; echo
}
cmd_set_cf_token() {  # rotate cloudflared connector token
  need kubectl
  printf 'Paste new Cloudflare tunnel token (starts eyJ): '
  read -r tok
  [ -n "$tok" ] || die "empty token"
  k -n platform delete secret cloudflared-token --ignore-not-found
  k -n platform create secret generic cloudflared-token --from-literal=token="$tok"
  k -n platform rollout restart deploy/cloudflared
  info "cloudflared-token replaced + restarted"
}
cmd_set_grafana_pw() {
  need kubectl
  local pw="${1:-}"; [ -n "$pw" ] || pw="$(openssl rand -base64 18)"
  k -n monitoring create secret generic grafana-admin \
    --from-literal=admin-user=admin --from-literal=admin-password="$pw" \
    --dry-run=client -o yaml | k apply -f -
  k -n monitoring rollout restart deploy/monitoring-grafana
  info "grafana password set -> admin / $pw"
}
cmd_creds() {  # gather every service credential into a gitignored CREDENTIALS.md
  need kubectl
  local out="$REPO/CREDENTIALS.md"
  local grafana_pw headlamp_tok qbit_pw cf_tok
  local doccat_pg_user doccat_pg_pw doccat_pg_db
  local flowers_pg_user flowers_pg_pw flowers_pg_db
  local anthropic_key gmail_secret vpn_key

  grafana_pw="$(cmd_grafana_pw 2>/dev/null || echo '(unavailable)')"
  headlamp_tok="$(cmd_token 168h 2>/dev/null || echo '(unavailable)')"
  qbit_pw="$(k -n media logs deploy/qbittorrent -c qbittorrent 2>/dev/null | grep -i password | tail -1)"
  [ -n "$qbit_pw" ] || qbit_pw="(not in logs — already changed, or check UI)"
  cf_tok="$(k -n platform get secret cloudflared-token -o jsonpath='{.data.token}' 2>/dev/null | base64 -d)"
  [ -n "$cf_tok" ] || cf_tok="(unavailable)"

  doccat_pg_user="$(k -n docs get secret doccat-postgres -o jsonpath='{.data.POSTGRES_USER}' 2>/dev/null | base64 -d)"
  doccat_pg_pw="$(k -n docs get secret doccat-postgres -o jsonpath='{.data.POSTGRES_PASSWORD}' 2>/dev/null | base64 -d)"
  doccat_pg_db="$(k -n docs get secret doccat-postgres -o jsonpath='{.data.POSTGRES_DB}' 2>/dev/null | base64 -d)"

  flowers_pg_user="$(k -n flowers get secret flowers-postgres -o jsonpath='{.data.POSTGRES_USER}' 2>/dev/null | base64 -d)"
  flowers_pg_pw="$(k -n flowers get secret flowers-postgres -o jsonpath='{.data.POSTGRES_PASSWORD}' 2>/dev/null | base64 -d)"
  flowers_pg_db="$(k -n flowers get secret flowers-postgres -o jsonpath='{.data.POSTGRES_DB}' 2>/dev/null | base64 -d)"

  anthropic_key="$(k -n docs get secret doccat-anthropic -o jsonpath='{.data.ANTHROPIC_API_KEY}' 2>/dev/null | base64 -d)"
  [ -n "$anthropic_key" ] || anthropic_key="(not set — Claude OCR escalation disabled)"
  gmail_secret="$(k -n docs get secret doccat-gmail -o json 2>/dev/null | grep -o '"[a-zA-Z0-9_.-]*\.json"' | tr -d '"' | tr '\n' ' ')"
  [ -n "$gmail_secret" ] || gmail_secret="(not set)"
  vpn_key="$(k -n media get secret gluetun-vpn -o jsonpath='{.data.WIREGUARD_PRIVATE_KEY}' 2>/dev/null | base64 -d)"
  [ -n "$vpn_key" ] || vpn_key="(unavailable)"

  {
    echo "# Homelab credentials — generated $(date -Iseconds)"
    echo
    echo "**Live secrets. Gitignored. Never commit, paste into a PR, or share.**"
    echo "Regenerate anytime with \`homelab creds\`."
    echo
    echo "## Admin UI logins"
    echo
    echo "| Service | URL | User | Password / Token |"
    echo "|---|---|---|---|"
    echo "| Grafana | https://$TAILNET_HOST:$GRAFANA_TS_PORT | admin | $grafana_pw |"
    echo "| Headlamp | https://$TAILNET_HOST | (bearer token) | $headlamp_tok |"
    echo "|  |  |  | expires in 168h — regenerate: \`homelab token\` |"
    echo "| qBittorrent | https://$TAILNET_HOST:8080 | admin | $qbit_pw |"
    echo "| Jellyfin | https://jellyfin.$DOMAIN | (self-managed) | set during Jellyfin's own setup wizard — not in a k8s Secret |"
    echo "| pgweb | (local-only) | — | no auth; \`kubectl -n docs port-forward svc/pgweb 8081:8081\` |"
    echo "| Flowers / Flowers Admin | https://flowers.$DOMAIN / :8092 | — | no login; network-gated only (Flowers Admin is tailnet-only) |"
    echo
    echo "## Databases"
    echo
    echo "| DB | Host | User | Password | DB name |"
    echo "|---|---|---|---|---|"
    echo "| docs (doc-catalog) | postgres.docs.svc.cluster.local:5432 | $doccat_pg_user | $doccat_pg_pw | $doccat_pg_db |"
    echo "| flowers | postgres.flowers.svc.cluster.local:5432 | $flowers_pg_user | $flowers_pg_pw | $flowers_pg_db |"
    echo
    echo "## API keys / OAuth / VPN (not logins — pipeline credentials)"
    echo
    echo "| What | Value | Notes |"
    echo "|---|---|---|"
    echo "| cloudflared tunnel token | $cf_tok | rotate: \`homelab set-cf-token\` |"
    echo "| doc-catalog Anthropic key | $anthropic_key | secret: docs/doccat-anthropic |"
    echo "| doc-catalog Gmail OAuth | $gmail_secret | secret: docs/doccat-gmail (per-account token-<label>.json) |"
    echo "| gluetun ProtonVPN key | $vpn_key | secret: media/gluetun-vpn |"
  } > "$out"
  info "wrote $out"
}
cmd_pgweb_sync() {  # mirror both Postgres secrets into platform for the shared pgweb bookmarks
  need kubectl
  command -v jq >/dev/null 2>&1 || die "jq is required (mirrors secret data without decoding it)"
  _pgweb_mirror() {
    local src_ns="$1" src_name="$2" dest_name="$3"
    k -n "$src_ns" get secret "$src_name" -o json \
      | jq --arg ns platform --arg name "$dest_name" \
        '.metadata = {name: $name, namespace: $ns} | del(.status)' \
      | k apply -f -
  }
  _pgweb_mirror docs doccat-postgres doccat-postgres-mirror
  _pgweb_mirror flowers flowers-postgres flowers-postgres-mirror
  info "mirrored doccat-postgres + flowers-postgres into platform for pgweb"
}
cmd_check_secrets() {
  need kubectl; local ok=0
  for s in "platform cloudflared-token" "monitoring grafana-admin"; do
    ns="${s% *}"; name="${s#* }"
    if k -n "$ns" get secret "$name" >/dev/null 2>&1; then
      printf '%s ok%s   %s/%s\n' "$c_grn" "$c_off" "$ns" "$name"
    else
      printf '%s miss%s %s/%s\n' "$c_red" "$c_off" "$ns" "$name"; ok=1
    fi
  done
  return $ok
}

# ---- status & urls --------------------------------------------------------
cmd_status() {
  need kubectl
  info "nodes"; k get nodes -o wide
  echo; info "pods (non-Running highlighted)"
  k get pods -A --no-headers | awk -v r="$c_red" -v o="$c_off" \
    '{s=$4} s!="Running" && s!="Completed" {print r $0 o; next} {print}'
  echo; info "cloudflared"
  k -n platform get deploy cloudflared -o wide 2>/dev/null || warn "cloudflared not deployed"
  if command -v tailscale >/dev/null 2>&1; then
    echo; info "tailscale"; tailscale status 2>/dev/null | head -5
    echo; info "tailscale serve"; tailscale serve status 2>/dev/null || sudo tailscale serve status 2>/dev/null || true
  fi
}
cmd_urls() {
  cat <<EOF
Public (Cloudflare):
  Homepage      https://home.$DOMAIN        (behind Cloudflare Access)
  Jellyfin      https://jellyfin.$DOMAIN
  Flowers       https://flowers.$DOMAIN

Private (Tailscale):
  Headlamp      https://$TAILNET_HOST
  Grafana       https://$TAILNET_HOST:$GRAFANA_TS_PORT
  Flowers Admin https://$TAILNET_HOST:8092
  qBittorrent   https://$TAILNET_HOST:8080
  pgweb         https://$TAILNET_HOST:8081
  Traefik       https://$TAILNET_HOST:8444/dashboard/
  Open WebUI    https://$TAILNET_HOST:8094
  Zot registry  https://$TAILNET_HOST:8095
  Hermes dash   https://$TAILNET_HOST:8096
  Hindsight UI  https://$TAILNET_HOST:8097

LAN:
  Jellyfin      http://$(server_ip):8096
EOF
}
cmd_health() {
  need kubectl
  local pf="curl -s -o /dev/null -w"
  declare -A t=(
    [jellyfin]="http://jellyfin.media.svc.cluster.local:8096/health"
    [homepage]="http://homepage.platform.svc.cluster.local:3000/"
    [headlamp]="http://$HEADLAMP_IP:80/"
    [grafana]="http://$GRAFANA_IP:80/api/health"
    [traefik]="http://$TRAEFIK_IP:8080/ping"
    [vllm]="http://vllm.local-llm.svc.cluster.local:8000/health"
    [open-webui]="http://$OPENWEBUI_IP:8080/health"
    [zot]="http://$ZOT_IP:5000/v2/"
    [hermes-dash]="http://$HERMES_DASH_IP:9119/"
    [hindsight-ui]="http://$HERMES_HINDSIGHT_UI_IP:8890/api/health"
  )
  for name in "${!t[@]}"; do
    code=$(k -n platform run hl-health-$$-"$name" --rm -i --restart=Never -q \
      --image=curlimages/curl:latest --command -- \
      $pf '%{http_code}' -H "Host: $name" --max-time 6 "${t[$name]}" 2>/dev/null || echo ERR)
    printf '%-10s %s\n' "$name" "$code"
  done
}

# ---- deploy & serve -------------------------------------------------------
cmd_apply() {
  need kubectl
  case "${1:-all}" in
    jellyfin)   k apply -k "$REPO/jellyfin/kubernetes/" ;;
    platform)   k apply -f "$REPO/platform/00-namespace.yaml"
                k apply -f "$REPO/platform/headlamp/" -f "$REPO/platform/homepage/"
                k apply -f "$REPO/cloudflare-tunnel/kubernetes/cloudflared-deployment.yaml"
                k apply -f "$REPO/platform/traefik/"
                k apply -f "$REPO/platform/zot/" ;;
    monitoring) k apply -f "$REPO/platform/monitoring/grafana-tailnet-svc.yaml"
                warn "helm-managed stack: use 'helm upgrade' with platform/monitoring/values.yaml" ;;
    llm)        k apply -k "$REPO/platform/nvidia-gpu-plugin/"
                k apply -k "$REPO/local-llm/kubernetes/" ;;
    hermes)     k apply -k "$REPO/hermes/kubernetes/" ;;
    all)        cmd_apply jellyfin; cmd_apply platform; cmd_apply monitoring; cmd_apply llm; cmd_apply hermes ;;
    *) die "unknown target: $1 (jellyfin|platform|monitoring|llm|hermes|all)" ;;
  esac
}
cmd_serve() {  # idempotent tailnet exposure for admin UIs
  need tailscale
  sudo tailscale serve --bg --https=443  "http://$HEADLAMP_IP:80"
  sudo tailscale serve --bg --https="$GRAFANA_TS_PORT" "http://$GRAFANA_IP:80"
  sudo tailscale serve --bg --https=8092 "http://$ADMIN_IP:8080"
  sudo tailscale serve --bg --https=8444 "http://$TRAEFIK_IP:8080"
  sudo tailscale serve --bg --https=8094 "http://$OPENWEBUI_IP:8080"
  sudo tailscale serve --bg --https=8095 "http://$ZOT_IP:5000"
  sudo tailscale serve --bg --https=8096 "http://$HERMES_DASH_IP:9119"
  sudo tailscale serve --bg --https=8097 "http://$HERMES_HINDSIGHT_UI_IP:8890"
  sudo tailscale serve --bg --https=9696 "http://$PROWLARR_IP:9696"
  sudo tailscale serve --bg --https=7878 "http://$RADARR_IP:7878"
  sudo tailscale serve --bg --https=8989 "http://$SONARR_IP:8989"
  info "serving Headlamp :443 + Grafana :$GRAFANA_TS_PORT + Flowers Admin :8092 + Traefik :8444 + Open WebUI :8094 + Zot :8095 + Hermes dashboard :8096 + Hindsight UI :8097 + Prowlarr :9696 + Radarr :7878 + Sonarr :8989 on $TAILNET_HOST"
  sudo tailscale serve status
}
cmd_restart() {
  need kubectl; [ $# -ge 1 ] || die "usage: homelab restart <svc>"
  local ns dep; ns="$(svc_ns "$1")" || die "unknown svc: $1"; dep="$(svc_dep "$1")"
  k -n "$ns" rollout restart deploy/"$dep"
  k -n "$ns" rollout status deploy/"$dep"
}
cmd_logs() {
  need kubectl; [ $# -ge 1 ] || die "usage: homelab logs <svc> [-f]"
  local svc="$1"; shift; local ns dep; ns="$(svc_ns "$svc")" || die "unknown svc: $svc"; dep="$(svc_dep "$svc")"
  k -n "$ns" logs deploy/"$dep" --tail=100 "$@"
}

# ---- node-join & debug ----------------------------------------------------
cmd_join_cmd() {
  local ip tok; ip="$(server_ip)"
  tok="$(sudo cat /var/lib/rancher/k3s/server/node-token 2>/dev/null)" \
    || die "need sudo to read node-token (run on the server node)"
  cat <<EOF
# Run on the NEW agent node:
curl -sfL https://get.k3s.io | K3S_URL=https://$ip:6443 K3S_TOKEN=$tok sh -

# Then, back here, label it if it should run specific workloads, e.g.:
#   kubectl label node <new-node> homelab/media-store=seagate
EOF
}
cmd_debug() {
  need kubectl
  info "non-ready pods"
  k get pods -A --field-selector=status.phase!=Running --no-headers 2>/dev/null \
    | grep -v Completed || echo "  (all Running)"
  echo; info "recent events"
  k get events -A --sort-by=.lastTimestamp 2>/dev/null | tail -15
  echo; info "node conditions"
  k get nodes -o "custom-columns=NAME:.metadata.name,READY:.status.conditions[-1].type,REASON:.status.conditions[-1].reason"
  echo; info "disk / zfs"
  df -h / /media/cheeky/seagate_hdd 2>/dev/null || true
  command -v zfs >/dev/null && zfs list -o name,used,avail,mountpoint 2>/dev/null | head
  echo; info "iGPU / media mount"
  ls -l /dev/dri 2>/dev/null || warn "no /dev/dri"
  findmnt /media/cheeky/seagate_hdd -o SOURCE,FSTYPE,OPTIONS 2>/dev/null || warn "USB not mounted"
  if command -v tailscale >/dev/null; then echo; info "tailscale"; tailscale status 2>/dev/null | head -3; fi
  if [ "${1:-}" != "" ]; then
    local ns dep; ns="$(svc_ns "$1")" || die "unknown svc: $1"; dep="$(svc_dep "$1")"
    echo; info "describe $1"; k -n "$ns" describe deploy/"$dep" | tail -30
    echo; info "logs $1"; k -n "$ns" logs deploy/"$dep" --tail=30 2>&1 || true
  fi
}

# ---- dispatch -------------------------------------------------------------
usage() {
  cat <<EOF
homelab — cheeky-mini k3s management CLI

Creds & secrets:
  token [dur]          Headlamp login bearer token (default 168h)
  grafana-pw           print Grafana admin password
  creds                gather every service credential into gitignored CREDENTIALS.md
  pgweb-sync           mirror doccat-postgres + flowers-postgres into platform for pgweb
  set-cf-token         paste + store a new cloudflared tunnel token, restart
  set-grafana-pw [pw]  set/rotate Grafana password (random if omitted)
  check-secrets        verify required secrets exist

Status & URLs:
  status               nodes, pods, cloudflared, tailscale
  urls                 all service URLs (public + tailnet + LAN)
  health               HTTP health check each service

Deploy & serve:
  apply [target]       kubectl apply  (jellyfin|platform|monitoring|llm|hermes|all)
  serve                (re)establish tailscale serve: Headlamp :443, Grafana :$GRAFANA_TS_PORT, Flowers Admin :8092, Traefik :8444, Open WebUI :8094, Zot :8095
  restart <svc>        rollout restart a service
  logs <svc> [-f]      tail a service's logs

Node-join & debug:
  join-cmd             print the agent-node join one-liner
  debug [svc]          diagnostics bundle (+ describe/logs for <svc>)

svc = jellyfin | homepage | headlamp | cloudflared | grafana | prometheus | admin | pgweb | vllm | open-webui | zot | hermes
Config via env: HOMELAB_DOMAIN, HOMELAB_TAILNET_HOST, KUBECONFIG, ...
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    token)          cmd_token "$@" ;;
    grafana-pw)     cmd_grafana_pw ;;
    creds)          cmd_creds ;;
    pgweb-sync)     cmd_pgweb_sync ;;
    set-cf-token)   cmd_set_cf_token ;;
    set-grafana-pw) cmd_set_grafana_pw "$@" ;;
    check-secrets)  cmd_check_secrets ;;
    status)         cmd_status ;;
    urls)           cmd_urls ;;
    health)         cmd_health ;;
    apply)          cmd_apply "$@" ;;
    serve)          cmd_serve ;;
    restart)        cmd_restart "$@" ;;
    logs)           cmd_logs "$@" ;;
    join-cmd)       cmd_join_cmd ;;
    debug)          cmd_debug "$@" ;;
    help|-h|--help) usage ;;
    *) warn "unknown command: $cmd"; echo; usage; exit 1 ;;
  esac
}
main "$@"
